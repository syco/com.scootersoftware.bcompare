{
  "id": "com.scootersoftware.bcompare",
  "command": "/app/bin/bcompare",
  "separate-locales": false,
  "runtime": "org.kde.Platform",
  "runtime-version": "6.10",
  "sdk": "org.kde.Sdk",
  "finish-args": [
    "--device=all",
    "--filesystem=home",
    "--share=ipc",
    "--socket=x11"
  ],
  "modules": [
    {
      "name": "libbz2",
      "no-autogen": true,
      "make-args": [
        "--f=Makefile-libbz2_so",
        "PREFIX=/app"
      ],
      "no-make-install": true,
      "post-install": [
        "mkdir -p /app/lib",
        "mv -v libbz2.so.1.0.8 /app/lib",
        "ln -s /app/lib/libbz2.so.1.0.8 /app/lib/libbz2.so.1.0"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://sourceware.org/pub/bzip2/bzip2-1.0.8.tar.gz",
          "sha256": "ab5a03176ee106d3f0fa90e381da478ddae405918153cca248e682cd0c4a2269"
        }
      ]
    },
    {
      "name" : "uthash",
      "buildsystem" : "simple",
      "build-commands" : [
        "install -D include/* /app/include"
      ],
      "sources" : [
        {
          "type" : "git",
          "url" : "https://github.com/troydhanson/uthash.git",
          "commit" : "6d8573997c21f24c7e4ec9e48734b44f384170a1"
        }
      ]
    },
    {
      "name" : "libdicom",
      "builddir" : true,
      "buildsystem" : "meson",
      "config-opts" : [
        "--buildtype=release",
        "--libdir=lib",
        "-Dtests=false"
      ],
      "sources" : [
        {
          "type" : "git",
          "url" : "https://github.com/ImagingDataCommons/libdicom.git",
          "tag" : "v1.3.0",
          "commit" : "8c84fdbef433395619f3b099e939d36877a9d48f"
        }
      ]
    },
    {
      "name" : "openslide",
      "builddir" : true,
      "buildsystem" : "meson",
      "config-opts" : [
        "--libdir=lib",
        "--buildtype=release"
      ],
      "sources" : [
        {
          "type" : "archive",
          "url" : "https://github.com/openslide/openslide/releases/download/v4.0.1/openslide-4.0.1.tar.xz",
          "sha256" : "df82f6b264f98d11eeb80d85bbb10c7935fcd69c7abae1d610ce49b9a0437faf"
        }
      ]
    },
    {
      "name": "bcompare",
      "sources": [
        {
          "type": "file",
          "url": "https://www.scootersoftware.com/files/bcompare-5.2.6.32774_amd64.deb",
          "dest-filename": "bcompare.deb",
          "sha256": "405124dcf88079951307458f874b617c438d37266ff2216bfb4128aa06f9b505"
        },
        {
          "type": "file",
          "path": "com.scootersoftware.bcompare.desktop"
        },
        {
          "type": "file",
          "path": "com.scootersoftware.bcompare.png"
        },
        {
          "type": "file",
          "path": "com.scootersoftware.bcompare.metainfo.xml"
        }
      ],
      "buildsystem": "simple",
      "build-commands": [
        "ar vx bcompare.deb",
        "tar vxf data.tar.gz --strip-components=2 -C /app",
        "rm -f bcompare.deb control.tar.gz data.tar.gz debian-binary",
        "sed -i 's;/usr/lib/beyondcompare;/app/lib/beyondcompare;g' /app/bin/bcompare"
      ],
      "post-install": [
        "install -Dm644 ${FLATPAK_ID}.metainfo.xml /app/share/metainfo/${FLATPAK_ID}.metainfo.xml",
        "install -Dm644 ${FLATPAK_ID}.desktop /app/share/applications/${FLATPAK_ID}.desktop",
        "install -Dm644 ${FLATPAK_ID}.png /app/share/icons/hicolor/512x512/apps/${FLATPAK_ID}.png",
        "install -Dm644 ${FLATPAK_ID}.png /app/usr/share/icons/${FLATPAK_ID}.png"
      ]
    }
  ]
}
